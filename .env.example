# Copia este archivo como .env para desarrollo local. En Vercel van en Settings → Environment Variables.

# Conexión a Postgres (Neon). En Neon: tu proyecto → Connect → copia la cadena "pooled connection".
# Para desarrollo usa una rama aparte de Neon (p. ej. "dev") para no tocar los datos reales.
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Llave con la que Better Auth firma las cookies de sesión. Genera una con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-una-llave-larga-y-aleatoria
