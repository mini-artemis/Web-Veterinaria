// Configuración de Cloudflare Workers para el sitio y el sistema con login.
// Guía completa en docs/DESPLIEGUE.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veterinaria",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Base de datos (Cloudflare D1, es SQLite). No lleva database_id: el primer `wrangler deploy`
  // la crea con este nombre y los siguientes (y los comandos `d1`) la encuentran por el nombre.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veterinaria-db",
      "migrations_dir": "migrations"
    }
  ],

  // Llave pública de Turnstile (captcha de Cloudflare). Esta es la llave de PRUEBA
  // que siempre aprueba; en producción cámbiala por la tuya.
  // La llave secreta NO va aquí: va en .dev.vars (local) y con `wrangler secret put` (producción).
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "PAISES_PERMITIDOS": "MX"
  }
}
