---
import { Image } from 'astro:assets';
import SistemaLayout from '../../../layouts/SistemaLayout.astro';
import logoImg from '../../../assets/logo.png';
import { puede } from '../../../lib/auth';
import {
  ahoraEnMexico,
  especiesCita,
  etiquetaHora,
  formatearFechaCita,
  horariosCita,
  leerCita,
  serviciosCita,
  type CitaDetallada,
} from '../../../lib/citas';
import { consulta, esDuplicado } from '../../../lib/db';
import { entero, pesos, texto } from '../../../lib/forms';
import { listarServicios } from '../../../lib/servicios';

export const prerender = false;

const usuario = Astro.locals.usuario!;
const esAdmin = puede(usuario, 'citas.administrar');
const esUsuario = usuario.rol === 'Usuario';

if (!esAdmin && !esUsuario) {
  return new Response('No tienes permiso para acceder a las citas.', { status: 403 });
}

let mensaje = '';
let error = '';
let abrirModal = false;
let valores: Record<string, string> = {};

// Fecha mínima permitida (hoy en zona horaria de México)
const { fecha: hoy } = ahoraEnMexico();

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = texto(datos, 'accion');

  if (accion === 'cancelar') {
    const citaId = entero(datos, 'id');
    if (!Number.isInteger(citaId) || citaId <= 0) {
      error = 'Cita no válida.';
    } else {
      const canceladas = await consulta<{ id: number; mascota: string; fecha: string; hora: string }>(
        `UPDATE citas
            SET estado = 'cancelada'
          WHERE id = $1
            AND ($2 OR usuario_id = $3)
            AND estado = 'programada'
        RETURNING id, mascota, fecha, hora`,
        [citaId, esAdmin, usuario.id],
      );
      if (canceladas.length > 0) {
        const c = canceladas[0];
        mensaje = `La cita de ${c.mascota} (${c.fecha} a las ${etiquetaHora(c.hora)}) fue cancelada y el horario quedó libre.`;
      } else {
        error = 'No se pudo cancelar la cita o ya estaba cancelada.';
      }
    }
  } else {
    const leido = leerCita(datos);
    const clienteId = esAdmin ? entero(datos, 'usuario_id') : usuario.id;

    valores = {
      usuario_id: texto(datos, 'usuario_id'),
      mascota: texto(datos, 'mascota'),
      especie: texto(datos, 'especie'),
      servicio: texto(datos, 'servicio'),
      fecha: texto(datos, 'fecha'),
      hora: texto(datos, 'hora'),
      notas: texto(datos, 'notas'),
    };

    if (leido.error) {
      error = leido.error;
      abrirModal = true;
    } else if (!Number.isInteger(clienteId) || clienteId <= 0) {
      error = 'Selecciona el cliente para la cita.';
      abrirModal = true;
    } else {
      const c = leido.cita!;
      try {
        await consulta(
          `INSERT INTO citas (usuario_id, mascota, especie, servicio, notas, fecha, hora, estado)
           VALUES ($1, $2, $3, $4, $5, $6, $7, 'programada')`,
          [clienteId, c.mascota, c.especie, c.servicio, c.notas, c.fecha, c.hora],
        );
        mensaje = `Cita agendada para ${c.mascota} el ${c.fecha} a las ${etiquetaHora(c.hora)}.`;
        valores = {};
      } catch (e) {
        abrirModal = true;
        error = esDuplicado(e)
          ? `El día ${c.fecha} a las ${etiquetaHora(c.hora)} ya está ocupado. Elige otro día u horario.`
          : 'No se pudo guardar la cita.';
      }
    }
  }
}

// Consultamos las citas (todas para el administrador, o solo las del cliente actual) y el catálogo de servicios activos
const [citas, ocupadas, clientes, listaServiciosActivos] = await Promise.all([
  consulta<CitaDetallada>(
    `SELECT c.id, c.usuario_id, u.nombre AS cliente_nombre, u.correo AS cliente_correo,
            c.mascota, c.especie, c.servicio, c.notas, c.fecha, c.hora, c.estado, c.creado_en
       FROM citas c
       JOIN usuarios u ON u.id = c.usuario_id
      WHERE ($1 OR c.usuario_id = $2)
      ORDER BY (c.estado = 'programada') DESC, c.fecha DESC, c.hora ASC`,
    [esAdmin, usuario.id],
  ),
  // Solo las citas activas ('programada') ocupan horario
  consulta<{ fecha: string; hora: string }>(
    "SELECT fecha, hora FROM citas WHERE estado = 'programada' AND fecha >= current_date - 1",
  ),
  esAdmin
    ? consulta<{ id: number; nombre: string; correo: string; rol: string }>(
        `SELECT u.id, u.nombre, u.correo, r.nombre AS rol
           FROM usuarios u
           JOIN roles r ON r.id = u.rol_id
          WHERE u.activo
          ORDER BY (r.nombre = 'Usuario') DESC, u.nombre`,
      )
    : Promise.resolve([]),
  listarServicios(),
]);

const mapaOcupadas: Record<string, string[]> = {};
for (const o of ocupadas) {
  (mapaOcupadas[o.fecha] ??= []).push(o.hora);
}
---

<SistemaLayout title={esAdmin ? 'Citas y reservaciones' : 'Mis citas'}>
  {mensaje && <p class="sis-alerta sis-alerta-ok" role="status">{mensaje}</p>}
  {error && !abrirModal && <p class="sis-alerta sis-alerta-error" role="alert">{error}</p>}

  <div class="sis-card">
    <div class="sis-citas-encabezado">
      <div>
        <h2>{esAdmin ? 'Citas agendadas por los clientes' : 'Mis citas programadas'}</h2>
        <p class="sis-muted">
          {citas.length === 0
            ? 'Todavía no hay citas registradas.'
            : `${citas.length} cita(s) registrada(s). Los horarios ocupados o pasados se bloquean automáticamente.`}
        </p>
      </div>
      <button type="button" id="btn-abrir-modal-cita" class="vet-btn-primary">
        + Nueva
      </button>
    </div>

    {esAdmin ? (
      <div class="sis-tabla-wrap">
        <table class="sis-tabla">
          <thead>
            <tr>
              <th scope="col">Folio</th>
              <th scope="col">Cliente</th>
              <th scope="col">Mascota</th>
              <th scope="col">Servicio</th>
              <th scope="col">Fecha</th>
              <th scope="col">Hora</th>
              <th scope="col">Estado</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {citas.map((c) => {
              const cancelada = c.estado === 'cancelada';
              return (
                <tr class:list={{ 'sis-inactivo': cancelada }}>
                  <td><strong>PK-{String(c.id).padStart(4, '0')}</strong></td>
                  <td>
                    {c.cliente_nombre}
                    <div class="sis-muted sis-texto-chico">{c.cliente_correo}</div>
                  </td>
                  <td>
                    {c.mascota} <span class="sis-badge sis-badge-ok">{c.especie}</span>
                  </td>
                  <td>
                    {c.servicio}
                    {c.notas && <div class="sis-muted sis-texto-chico">{c.notas}</div>}
                  </td>
                  <td>{c.fecha}</td>
                  <td>{etiquetaHora(c.hora)}</td>
                  <td>
                    <span class:list={['sis-badge', cancelada ? 'sis-badge-alerta' : 'sis-badge-ok']}>
                      {cancelada ? 'Cancelada' : 'Programada'}
                    </span>
                  </td>
                  <td>
                    <div class="sis-inline">
                      <a href={`/sistema/citas/${c.id}/pdf`} class="sis-btn-sec sis-btn-link" download>
                        Descargar PDF
                      </a>
                      {!cancelada && (
                        <form
                          method="post"
                          class="sis-inline form-cancelar-cita"
                          data-mascota={c.mascota}
                        >
                          <input type="hidden" name="accion" value="cancelar" />
                          <input type="hidden" name="id" value={c.id} />
                          <button type="submit" class="sis-btn-sec sis-btn-peligro">
                            Cancelar
                          </button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
            {citas.length === 0 && (
              <tr>
                <td colspan="8" class="sis-muted">No hay citas agendadas todavía. Usa el botón "+ Nueva" para registrar una.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="sis-citas-tarjetas">
        {citas.map((c) => {
          const cancelada = c.estado === 'cancelada';
          return (
            <article class:list={['sis-cita-bloque', { 'sis-cita-cancelada': cancelada }]}>
              <div class="sis-cita-acciones-pdf">
                <a href={`/sistema/citas/${c.id}/pdf`} class="vet-btn-primary sis-btn-link" download>
                  Descargar PDF
                </a>
                {!cancelada && (
                  <form method="post" class="sis-inline form-cancelar-cita" data-mascota={c.mascota}>
                    <input type="hidden" name="accion" value="cancelar" />
                    <input type="hidden" name="id" value={c.id} />
                    <button type="submit" class="sis-btn-sec sis-btn-peligro">
                      Cancelar cita
                    </button>
                  </form>
                )}
              </div>
              <div class="sis-cita-ticket">
                <header class="sis-cita-ticket-head">
                  <div>
                    <strong>Puppy and Kitty</strong>
                    <span>
                      Folio PK-{String(c.id).padStart(4, '0')} · {cancelada ? 'CANCELADA' : 'PROGRAMADA'}
                    </span>
                  </div>
                  <Image src={logoImg} alt="Logo Puppy and Kitty" width={40} height={40} class="sis-cita-ticket-logo" />
                </header>
                <dl class="sis-datos sis-cita-ticket-body">
                  <dt>Estado</dt>
                  <dd>
                    <span class:list={['sis-badge', cancelada ? 'sis-badge-alerta' : 'sis-badge-ok']}>
                      {cancelada ? 'Cancelada' : 'Programada'}
                    </span>
                  </dd>
                  <dt>Cliente</dt>
                  <dd>{c.cliente_nombre}</dd>
                  <dt>Mascota</dt>
                  <dd>{c.mascota} ({c.especie})</dd>
                  <dt>Servicio</dt>
                  <dd>{c.servicio}</dd>
                  <dt>Fecha</dt>
                  <dd>{formatearFechaCita(c.fecha)}</dd>
                  <dt>Hora</dt>
                  <dd>{etiquetaHora(c.hora)}</dd>
                  {c.notas && (
                    <>
                      <dt>Notas</dt>
                      <dd>{c.notas}</dd>
                    </>
                  )}
                </dl>
                <footer class="sis-cita-ticket-foot">
                  Av. de las Mascotas #123, Col. Del Parque · Presentar 10 min antes
                </footer>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>

  <!-- Modal para crear nueva cita -->
  <dialog id="modal-cita" class="sis-modal" data-abrir={abrirModal ? 'true' : 'false'}>
    <div class="sis-modal-contenido">
      <div class="sis-modal-head">
        <h2>Agendar nueva cita</h2>
        <button type="button" id="btn-cerrar-modal-cita" class="sis-btn-sec" aria-label="Cerrar ventana">
          ✕
        </button>
      </div>

      {error && abrirModal && <p class="sis-alerta sis-alerta-error" role="alert">{error}</p>}

      <form method="post" class="sis-form" id="form-nueva-cita">
        <input type="hidden" name="accion" value="crear" />
        {esAdmin && (
          <label>
            Cliente
            <select name="usuario_id" required>
              <option value="">Selecciona un cliente...</option>
              {clientes.map((cl) => (
                <option value={cl.id} selected={String(cl.id) === valores.usuario_id}>
                  {cl.nombre} ({cl.correo}) — {cl.rol}
                </option>
              ))}
            </select>
          </label>
        )}

        <div class="sis-form-grid">
          <label>
            Nombre de la mascota
            <input name="mascota" required maxlength="60" value={valores.mascota ?? ''} placeholder="Ej. Firulais, Michi..." />
          </label>

          <label>
            Especie
            <select name="especie" required>
              {especiesCita.map((esp) => (
                <option value={esp} selected={valores.especie === esp}>
                  {esp}
                </option>
              ))}
            </select>
          </label>
        </div>

        <label>
          Servicio o motivo
          <select name="servicio" required>
            {(listaServiciosActivos.length > 0 ? listaServiciosActivos : serviciosCita.map((nombre) => ({ nombre, icono: '🩺', precio: 0 }))).map((srv) => (
              <option value={srv.nombre} selected={valores.servicio === srv.nombre}>
                {srv.icono} {srv.nombre}{srv.precio > 0 ? ` — ${pesos(srv.precio)}` : ''}
              </option>
            ))}
          </select>
        </label>

        <div class="sis-form-grid">
          <label>
            Día de la cita
            <input
              type="date"
              name="fecha"
              id="cita-fecha"
              required
              min={hoy}
              value={valores.fecha || hoy}
            />
          </label>

          <label>
            Hora
            <select name="hora" id="cita-hora" required data-seleccionada={valores.hora ?? ''}>
              {horariosCita.map((h) => (
                <option value={h.valor} selected={valores.hora === h.valor}>
                  {h.etiqueta}
                </option>
              ))}
            </select>
          </label>
        </div>

        <p id="aviso-horario-ocupado" class="sis-muted sis-texto-chico" aria-live="polite"></p>

        <label>
          Notas adicionales (opcional)
          <textarea name="notas" rows="2" maxlength="250" placeholder="Síntomas o indicaciones especiales">{valores.notas ?? ''}</textarea>
        </label>

        <div class="sis-modal-botones">
          <button type="submit" id="btn-guardar-cita" class="vet-btn-primary">Agendar cita</button>
          <button type="button" id="btn-cancelar-cita" class="sis-btn-sec">Cancelar</button>
        </div>
      </form>
    </div>
  </dialog>

  <script is:inline id="datos-ocupadas" type="application/json" set:html={JSON.stringify(mapaOcupadas)} />
</SistemaLayout>

<script>
  const modal = document.getElementById('modal-cita') as HTMLDialogElement | null;
  const btnAbrir = document.getElementById('btn-abrir-modal-cita');
  const btnCerrar = document.getElementById('btn-cerrar-modal-cita');
  const btnCancelar = document.getElementById('btn-cancelar-cita');
  const inputFecha = document.getElementById('cita-fecha') as HTMLInputElement | null;
  const selectHora = document.getElementById('cita-hora') as HTMLSelectElement | null;
  const avisoHorario = document.getElementById('aviso-horario-ocupado');
  const btnGuardar = document.getElementById('btn-guardar-cita') as HTMLButtonElement | null;

  const ocupadasJson = document.getElementById('datos-ocupadas')?.textContent ?? '{}';
  const mapaOcupadas: Record<string, string[]> = JSON.parse(ocupadasJson);

  function obtenerAhoraMexico() {
    const ahora = new Date();
    const fechaHoy = ahora.toLocaleDateString('en-CA', { timeZone: 'America/Mexico_City' });
    const horaActual = ahora.toLocaleTimeString('en-GB', {
      timeZone: 'America/Mexico_City',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    return { fechaHoy, horaActual };
  }

  function actualizarHorasDisponibles() {
    if (!inputFecha || !selectHora) return;
    const fecha = inputFecha.value;
    const { fechaHoy, horaActual } = obtenerAhoraMexico();
    const ocupadasDelDia = new Set(mapaOcupadas[fecha] ?? []);
    let disponibles = 0;
    let pasadas = 0;
    let primeraDisponible = '';

    for (const opcion of Array.from(selectHora.options)) {
      const etiquetaBase =
        opcion.dataset.etiquetaBase ??
        opcion.textContent?.replace(/ \((Ocupado|Ya pasó)\)$/, '').trim() ??
        '';
      opcion.dataset.etiquetaBase = etiquetaBase;

      const yaPaso = fecha < fechaHoy || (fecha === fechaHoy && opcion.value <= horaActual);

      if (ocupadasDelDia.has(opcion.value)) {
        opcion.disabled = true;
        opcion.textContent = `${etiquetaBase} (Ocupado)`;
      } else if (yaPaso) {
        opcion.disabled = true;
        opcion.textContent = `${etiquetaBase} (Ya pasó)`;
        pasadas++;
      } else {
        opcion.disabled = false;
        opcion.textContent = etiquetaBase;
        disponibles++;
        if (!primeraDisponible) primeraDisponible = opcion.value;
      }
    }

    if (selectHora.selectedOptions[0]?.disabled && primeraDisponible) {
      selectHora.value = primeraDisponible;
    }

    if (avisoHorario && btnGuardar) {
      if (disponibles === 0) {
        avisoHorario.textContent =
          fecha === fechaHoy && pasadas > 0 && ocupadasDelDia.size === 0
            ? 'Ya pasaron todos los horarios de atención de hoy. Por favor elige otro día.'
            : 'No quedan horarios disponibles en esta fecha (ocupados o ya pasaron). Por favor elige otro día.';
        btnGuardar.disabled = true;
      } else if (ocupadasDelDia.size > 0 || pasadas > 0) {
        avisoHorario.textContent = `Horarios disponibles: ${disponibles}. Los horarios pasados u ocupados están bloqueados.`;
        btnGuardar.disabled = false;
      } else {
        avisoHorario.textContent = 'Todos los horarios están disponibles para esta fecha.';
        btnGuardar.disabled = false;
      }
    }
  }

  inputFecha?.addEventListener('change', actualizarHorasDisponibles);
  actualizarHorasDisponibles();

  btnAbrir?.addEventListener('click', () => {
    actualizarHorasDisponibles();
    modal?.showModal();
  });

  btnCerrar?.addEventListener('click', () => modal?.close());
  btnCancelar?.addEventListener('click', () => modal?.close());

  // Cerrar el modal al hacer clic fuera de la tarjeta
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  if (modal?.dataset.abrir === 'true') {
    modal.showModal();
  }

  // Confirmación antes de cancelar una cita
  document.querySelectorAll<HTMLFormElement>('.form-cancelar-cita').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const mascota = form.dataset.mascota ?? 'esta mascota';
      if (!confirm(`¿Seguro que deseas cancelar la cita de ${mascota}?`)) {
        e.preventDefault();
      }
    });
  });
</script>
