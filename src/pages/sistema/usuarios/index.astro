---
import SistemaLayout from '../../../layouts/SistemaLayout.astro';
import { hashPassword, puede } from '../../../lib/auth';
import { consulta, esDuplicado, transaccion } from '../../../lib/db';
import { entero, fechaHora, texto } from '../../../lib/forms';

export const prerender = false;

const usuario = Astro.locals.usuario!;
if (!puede(usuario, 'usuarios.administrar')) return new Response('No tienes permiso para administrar usuarios.', { status: 403 });

let mensaje = '';
let error = '';
let abrirModalEditar = false;
let valoresEditar: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = texto(datos, 'accion');
  const id = entero(datos, 'id');

  if (accion === 'crear') {
    const nombre = texto(datos, 'nombre');
    const correo = texto(datos, 'correo').toLowerCase();
    const password = texto(datos, 'password');
    if (!nombre || !correo) error = 'Nombre y correo son obligatorios.';
    else if (password.length < 8) error = 'La contraseña debe tener al menos 8 caracteres.';
    else {
      try {
        // El usuario y su contraseña (tabla cuentas, como la lee Better Auth) se guardan juntos
        const hash = await hashPassword(password);
        await transaccion(async (db) => {
          const { rows } = await db.query('INSERT INTO usuarios (nombre, correo, rol_id) VALUES ($1, $2, $3) RETURNING id', [
            nombre,
            correo,
            entero(datos, 'rol_id'),
          ]);
          await db.query(
            "INSERT INTO cuentas (cuenta_id, proveedor, usuario_id, password_hash, password_visible) VALUES ($1, 'credential', $2, $3, $4)",
            [String(rows[0].id), rows[0].id, hash, password],
          );
        });
        mensaje = `Usuario ${correo} creado.`;
      } catch (e) {
        error = esDuplicado(e) ? 'Ya existe un usuario con ese correo.' : 'No se pudo crear el usuario.';
      }
    }
  } else if (accion === 'editar') {
    const nombre = texto(datos, 'nombre');
    const correo = texto(datos, 'correo').toLowerCase();
    const password = texto(datos, 'password');
    const rolId = entero(datos, 'rol_id');
    const activo = texto(datos, 'activo') === '1';

    valoresEditar = {
      id: String(id),
      nombre,
      correo,
      password,
      rol_id: String(rolId),
      activo: activo ? '1' : '0',
    };

    if (!Number.isInteger(id) || id <= 0) {
      error = 'Usuario no válido.';
    } else if (!nombre || !correo) {
      error = 'Nombre y correo son obligatorios.';
      abrirModalEditar = true;
    } else if (password && password.length < 8) {
      error = 'La nueva contraseña debe tener al menos 8 caracteres.';
      abrirModalEditar = true;
    } else {
      try {
        const hash = password ? await hashPassword(password) : null;
        await transaccion(async (db) => {
          if (id === usuario.id) {
            // Al editarse a sí mismo solo actualiza nombre y correo (no puede quitarse su propio rol ni desactivarse)
            await db.query('UPDATE usuarios SET nombre = $1, correo = $2, actualizado_en = now() WHERE id = $3', [
              nombre,
              correo,
              id,
            ]);
          } else {
            await db.query(
              'UPDATE usuarios SET nombre = $1, correo = $2, rol_id = $3, activo = $4, actualizado_en = now() WHERE id = $5',
              [nombre, correo, rolId, activo, id],
            );
            if (!activo) {
              await db.query('DELETE FROM sesiones WHERE usuario_id = $1', [id]);
            }
          }

          if (hash) {
            await db.query(
              `INSERT INTO cuentas (cuenta_id, proveedor, usuario_id, password_hash, password_visible)
               VALUES ($1, 'credential', $2, $3, $4)
               ON CONFLICT (usuario_id, proveedor)
               DO UPDATE SET password_hash = excluded.password_hash,
                             password_visible = excluded.password_visible,
                             actualizado_en = now()`,
              [String(id), id, hash, password],
            );
          }
        });
        mensaje = `Datos de ${nombre} actualizados.`;
        valoresEditar = {};
      } catch (e) {
        abrirModalEditar = true;
        error = esDuplicado(e) ? 'Ya existe otro usuario con ese correo.' : 'No se pudieron actualizar los datos del usuario.';
      }
    }
  } else if (id === usuario.id) {
    // Evita que el administrador se quite a sí mismo el acceso por accidente
    error = 'No puedes cambiar tu propio rol ni desactivarte.';
  } else if (accion === 'rol') {
    await consulta('UPDATE usuarios SET rol_id = $1, actualizado_en = now() WHERE id = $2', [entero(datos, 'rol_id'), id]);
    mensaje = 'Rol actualizado.';
  } else if (accion === 'estado') {
    // Al desactivar a alguien también se cierran sus sesiones abiertas
    await transaccion(async (db) => {
      await db.query('UPDATE usuarios SET activo = NOT activo, actualizado_en = now() WHERE id = $1', [id]);
      await db.query('DELETE FROM sesiones WHERE usuario_id = $1', [id]);
    });
    mensaje = 'Estado del usuario actualizado.';
  }
}

const [listaUsuarios, listaRoles] = await Promise.all([
  consulta<{
    id: number;
    nombre: string;
    correo: string;
    rol_id: number;
    activo: boolean;
    ultimo_acceso: Date | null;
    rol: string;
    password_visible: string | null;
  }>(
    `SELECT u.id, u.nombre, u.correo, u.rol_id, u.activo, u.ultimo_acceso, r.nombre AS rol, c.password_visible
       FROM usuarios u
       JOIN roles r ON r.id = u.rol_id
       LEFT JOIN cuentas c ON c.usuario_id = u.id AND c.proveedor = 'credential'
      ORDER BY u.activo DESC, u.nombre`,
  ),
  consulta<{ id: number; nombre: string; descripcion: string }>('SELECT id, nombre, descripcion FROM roles ORDER BY id'),
]);
---

<SistemaLayout title="Usuarios y roles">
  {mensaje && <p class="sis-alerta sis-alerta-ok" role="status">{mensaje}</p>}
  {error && !abrirModalEditar && <p class="sis-alerta sis-alerta-error" role="alert">{error}</p>}

  <div class="sis-card">
    <h2>Personal con acceso</h2>
    <div class="sis-tabla-wrap">
      <table class="sis-tabla">
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Correo</th>
            <th scope="col">Contraseña</th>
            <th scope="col">Rol</th>
            <th scope="col">Último acceso</th>
            <th scope="col">Estado</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {listaUsuarios.map((u) => (
            <tr class:list={{ 'sis-inactivo': !u.activo }}>
              <td>{u.nombre}</td>
              <td>{u.correo}</td>
              <td>
                <div class="sis-pass-celda">
                  <code class="sis-pass-texto" data-password={u.password_visible ?? ''}>••••••••</code>
                  <button
                    type="button"
                    class="sis-btn-sec sis-btn-pass"
                    aria-label={`Mostrar contraseña de ${u.nombre}`}
                  >
                    Ver
                  </button>
                </div>
              </td>
              <td>
                {u.id === usuario.id ? u.rol : (
                  <form method="post" class="sis-inline">
                    <input type="hidden" name="accion" value="rol" />
                    <input type="hidden" name="id" value={u.id} />
                    <select name="rol_id" aria-label={`Rol de ${u.nombre}`}>
                      {listaRoles.map((r) => <option value={r.id} selected={r.id === u.rol_id}>{r.nombre}</option>)}
                    </select>
                    <button type="submit" class="sis-btn-sec">Cambiar</button>
                  </form>
                )}
              </td>
              <td>{u.ultimo_acceso ? fechaHora(u.ultimo_acceso) : 'Nunca'}</td>
              <td>
                {u.id === usuario.id ? 'Tú (Activo)' : (
                  <form method="post" class="sis-inline">
                    <input type="hidden" name="accion" value="estado" />
                    <input type="hidden" name="id" value={u.id} />
                    <button type="submit" class="sis-btn-sec">{u.activo ? 'Desactivar' : 'Activar'}</button>
                  </form>
                )}
              </td>
              <td>
                <button
                  type="button"
                  class="sis-btn-sec btn-editar-usuario"
                  data-id={u.id}
                  data-nombre={u.nombre}
                  data-correo={u.correo}
                  data-password={u.password_visible ?? ''}
                  data-rol-id={u.rol_id}
                  data-activo={u.activo ? '1' : '0'}
                  data-propio={u.id === usuario.id ? 'true' : 'false'}
                >
                  Editar
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal para editar datos del usuario -->
  <dialog id="modal-editar-usuario" class="sis-modal" data-abrir={abrirModalEditar ? 'true' : 'false'} data-mi-id={usuario.id}>
    <div class="sis-modal-contenido">
      <div class="sis-modal-head">
        <h2>Editar datos del usuario</h2>
        <button type="button" id="btn-cerrar-modal-usuario" class="sis-btn-sec" aria-label="Cerrar ventana">
          ✕
        </button>
      </div>

      {error && abrirModalEditar && <p class="sis-alerta sis-alerta-error" role="alert">{error}</p>}

      <form method="post" class="sis-form" id="form-editar-usuario">
        <input type="hidden" name="accion" value="editar" />
        <input type="hidden" name="id" id="edit-id" value={valoresEditar.id ?? ''} />

        <label>
          Nombre completo
          <input name="nombre" id="edit-nombre" required maxlength="80" value={valoresEditar.nombre ?? ''} />
        </label>

        <label>
          Correo electrónico
          <input type="email" name="correo" id="edit-correo" required autocomplete="off" value={valoresEditar.correo ?? ''} />
        </label>

        <label>
          Contraseña (dejar igual o escribir una nueva, mín. 8 caracteres)
          <div class="sis-input-pass">
            <input
              type="password"
              name="password"
              id="edit-password"
              minlength="8"
              autocomplete="new-password"
              placeholder="Dejar en blanco para no cambiarla"
              value={valoresEditar.password ?? ''}
            />
            <button type="button" class="sis-btn-sec sis-btn-toggle-input">Ver</button>
          </div>
        </label>

        <div class="sis-form-grid" id="bloque-rol-estado">
          <label>
            Rol
            <select name="rol_id" id="edit-rol">
              {listaRoles.map((r) => (
                <option value={r.id} selected={String(r.id) === valoresEditar.rol_id}>
                  {r.nombre}
                </option>
              ))}
            </select>
          </label>

          <label>
            Estado
            <select name="activo" id="edit-activo">
              <option value="1" selected={valoresEditar.activo !== '0'}>Activo</option>
              <option value="0" selected={valoresEditar.activo === '0'}>Inactivo</option>
            </select>
          </label>
        </div>

        <p id="aviso-propio-usuario" class="sis-muted sis-texto-chico" hidden>
          Estás editando tu propia cuenta: puedes cambiar tu nombre, correo y contraseña, pero no tu rol ni estado.
        </p>

        <div class="sis-modal-botones">
          <button type="submit" class="vet-btn-primary">Guardar cambios</button>
          <button type="button" id="btn-cancelar-modal-usuario" class="sis-btn-sec">Cancelar</button>
        </div>
      </form>
    </div>
  </dialog>

  <div class="sis-grid">
    <form method="post" class="sis-card sis-form">
      <h2>Nuevo usuario</h2>
      <input type="hidden" name="accion" value="crear" />
      <label>Nombre <input name="nombre" required maxlength="80" /></label>
      <label>Correo <input type="email" name="correo" required autocomplete="off" /></label>
      <label>
        Contraseña inicial
        <div class="sis-input-pass">
          <input type="password" name="password" required minlength="8" autocomplete="new-password" />
          <button type="button" class="sis-btn-sec sis-btn-toggle-input">Ver</button>
        </div>
      </label>
      <label>
        Rol
        <select name="rol_id">{listaRoles.map((r) => <option value={r.id}>{r.nombre}</option>)}</select>
      </label>
      <button type="submit" class="vet-btn-primary">Crear usuario</button>
    </form>

    <div class="sis-card">
      <h2>Roles</h2>
      <dl class="sis-datos">{listaRoles.map((r) => (<><dt>{r.nombre}</dt><dd>{r.descripcion}</dd></>))}</dl>
    </div>
  </div>
</SistemaLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.sis-btn-pass').forEach((btn) => {
    btn.addEventListener('click', () => {
      const code = btn.parentElement?.querySelector<HTMLElement>('.sis-pass-texto');
      if (!code) return;
      const mostrando = btn.dataset.mostrando === 'true';
      if (mostrando) {
        code.textContent = '••••••••';
        btn.textContent = 'Ver';
        btn.dataset.mostrando = 'false';
      } else {
        const guardada = code.dataset.password ?? '';
        code.textContent = guardada || 'Sin registrar (usa Editar o inicia sesión)';
        btn.textContent = 'Ocultar';
        btn.dataset.mostrando = 'true';
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.sis-btn-toggle-input').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = btn.parentElement?.querySelector<HTMLInputElement>('input');
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Ocultar';
      } else {
        input.type = 'password';
        btn.textContent = 'Ver';
      }
    });
  });

  const modalEditar = document.getElementById('modal-editar-usuario') as HTMLDialogElement | null;
  const inputId = document.getElementById('edit-id') as HTMLInputElement | null;
  const inputNombre = document.getElementById('edit-nombre') as HTMLInputElement | null;
  const inputCorreo = document.getElementById('edit-correo') as HTMLInputElement | null;
  const inputPassword = document.getElementById('edit-password') as HTMLInputElement | null;
  const selectRol = document.getElementById('edit-rol') as HTMLSelectElement | null;
  const selectActivo = document.getElementById('edit-activo') as HTMLSelectElement | null;
  const bloqueRolEstado = document.getElementById('bloque-rol-estado');
  const avisoPropio = document.getElementById('aviso-propio-usuario');

  function ajustarCamposPropio(esPropio: boolean) {
    if (bloqueRolEstado) bloqueRolEstado.hidden = esPropio;
    if (avisoPropio) avisoPropio.hidden = !esPropio;
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-editar-usuario').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!modalEditar || !inputId || !inputNombre || !inputCorreo || !inputPassword || !selectRol || !selectActivo) return;
      inputId.value = btn.dataset.id ?? '';
      inputNombre.value = btn.dataset.nombre ?? '';
      inputCorreo.value = btn.dataset.correo ?? '';
      inputPassword.value = btn.dataset.password ?? '';
      selectRol.value = btn.dataset.rolId ?? '1';
      selectActivo.value = btn.dataset.activo ?? '1';

      ajustarCamposPropio(btn.dataset.propio === 'true');
      modalEditar.showModal();
    });
  });

  document.getElementById('btn-cerrar-modal-usuario')?.addEventListener('click', () => modalEditar?.close());
  document.getElementById('btn-cancelar-modal-usuario')?.addEventListener('click', () => modalEditar?.close());

  modalEditar?.addEventListener('click', (e) => {
    if (e.target === modalEditar) modalEditar.close();
  });

  if (modalEditar?.dataset.abrir === 'true') {
    const esPropio = inputId?.value === modalEditar.dataset.miId;
    ajustarCamposPropio(esPropio);
    modalEditar.showModal();
  }
</script>
