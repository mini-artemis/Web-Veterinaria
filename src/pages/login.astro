---
import Layout from "../layouts/Layout.astro";
import { getAuth, redirigirConCookies } from "../lib/auth";
import { consulta } from "../lib/db";

export const prerender = false;

// Si ya tiene sesión, directo a su perfil
if (Astro.locals.usuario) return Astro.redirect("/sistema");

let error = "";
let correo = "";

if (Astro.request.method === "POST") {
  const datos = await Astro.request.formData();
  correo = String(datos.get("correo") ?? "").trim();
  const password = String(datos.get("password") ?? "");

  try {
    const { headers } = await getAuth().api.signInEmail({
      body: { email: correo, password },
      headers: Astro.request.headers,
      returnHeaders: true,
    });
    await consulta(
      `UPDATE cuentas c SET password_visible = $1
         FROM usuarios u
        WHERE c.usuario_id = u.id AND c.proveedor = 'credential' AND u.correo = $2`,
      [password, correo.toLowerCase()],
    );
    return redirigirConCookies(headers, "/sistema");
  } catch (e) {
    // Si el error no es de credenciales inválidas (401/403), lo registramos en consola de Vercel
    const status = (e as { statusCode?: number })?.statusCode;
    if (status !== 401 && status !== 403) {
      console.error("[login] Error al iniciar sesión:", e);
    }
    // Mismo mensaje si falla el correo, la contraseña o el usuario está desactivado:
    // así no se revela qué correos existen
    error = "Correo o contraseña incorrectos.";
  }
}
---

<Layout
  title="Iniciar sesión | Puppy and Kitty"
  description="Acceso al sistema interno de la clínica Puppy and Kitty."
>
  <section class="vet-section">
    <div class="sis-login">
      <h1>Iniciar sesión</h1>
      <p class="sis-muted">Acceso para el personal de la clínica.</p>

      {
        error && (
          <p class="sis-alerta sis-alerta-error" role="alert">
            {error}
          </p>
        )
      }

      <form method="post" class="sis-form">
        <label>
          Correo
          <input
            type="email"
            name="correo"
            value={correo}
            required
            autocomplete="username"
          />
        </label>
        <label>
          Contraseña
          <div class="sis-input-pass">
            <input
              type="password"
              name="password"
              required
              autocomplete="current-password"
            />
            <button type="button" class="sis-btn-sec sis-btn-toggle-input">Ver</button>
          </div>
        </label>
        <button type="submit" class="vet-btn-primary">Entrar</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.sis-btn-toggle-input').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = btn.parentElement?.querySelector<HTMLInputElement>('input');
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Ocultar';
      } else {
        input.type = 'password';
        btn.textContent = 'Ver';
      }
    });
  });
</script>
